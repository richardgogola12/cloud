# Cloud – Apache
Options -Indexes
DirectoryIndex index.php

# zakázané priečinky a súbory
RedirectMatch 404 ^/(.*/)?(inc|storage)(/|$)
<FilesMatch "^(config\.php|secret\.key\.php|schema\.sql|.*\.md)$">
    Require all denied
</FilesMatch>

AddType application/manifest+json .webmanifest
<IfModule mod_headers.c>
    <Files "sw.js">
        Header set Cache-Control "no-cache"
    </Files>
</IfModule>

# limity nahrávania (funguje pri mod_php; pri PHP-FPM nastav v php.ini / .user.ini)
<IfModule mod_php.c>
    php_value upload_max_filesize 512M
    php_value post_max_size 520M
    php_value max_execution_time 300
    php_value memory_limit 256M
</IfModule>

# >>> CLOUD-DAV (sieťový disk WebDAV – PHP musí dostať hlavičku Authorization aj pri PHP-FPM)
<IfModule mod_setenvif.c>
    SetEnvIfNoCase Authorization "(.+)" HTTP_AUTHORIZATION=$1
</IfModule>
# <<< CLOUD-DAV

# >>> CLOUD-PERF (rýchlosť: kompresia a cache súborov stránky)
<IfModule mod_deflate.c>
<IfModule mod_filter.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript text/javascript application/json image/svg+xml application/manifest+json
</IfModule>
</IfModule>
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(woff2?|png|svg|ico|webp|jpg)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    <Files "sw.js">
        Header set Cache-Control "no-cache"
    </Files>
</IfModule>
# <<< CLOUD-PERF
