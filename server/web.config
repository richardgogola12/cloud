<?xml version="1.0" encoding="UTF-8"?>
<!-- Cloud – IIS (Windows Server). Obdoba súboru .htaccess pre Apache. -->
<configuration>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.php" />
      </files>
    </defaultDocument>
    <directoryBrowse enabled="false" />
    <security>
      <requestFiltering>
        <!-- zakázané priečinky a súbory -->
        <hiddenSegments>
          <add segment="inc" />
          <add segment="storage" />
          <add segment="config.php" />
          <add segment="secret.key.php" />
          <add segment="schema.sql" />
        </hiddenSegments>
        <fileExtensions>
          <add fileExtension=".md" allowed="false" />
        </fileExtensions>
        <!-- nahrávanie po častiach – stačí rezerva nad veľkosť jednej časti; veľké súbory nahrá aplikácia postupne -->
        <requestLimits maxAllowedContentLength="545259520" />
        <!-- WebDAV (sieťový disk) potrebuje aj iné metódy než GET/POST -->
        <verbs allowUnlisted="true" />
      </requestFiltering>
    </security>
    <!-- vlastný WebDAV v IIS by prebral požiadavky sieťového disku Cloudu -->
    <modules>
      <remove name="WebDAVModule" />
    </modules>
    <handlers>
      <remove name="WebDAV" />
    </handlers>
    <staticContent>
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />
  </system.webServer>
  <location path="sw.js">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
