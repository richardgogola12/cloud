<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:id="@+id/w_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/widget_logo_bg"
            android:contentDescription="@null"
            android:padding="5dp"
            android:src="@drawable/ic_stat_cloud" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Cloud synchronizácia"
            android:textColor="@color/ink"
            android:textSize="15sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/w_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_chip_ok"
            android:paddingStart="10dp"
            android:paddingTop="3dp"
            android:paddingEnd="10dp"
            android:paddingBottom="3dp"
            android:text="Aktívne"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Všetko je synchronizované"
        android:textColor="@color/ink"
        android:textSize="14sp" />

    <ProgressBar
        android:id="@+id/w_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="6dp"
        android:max="100"
        android:progressTint="@color/brand"
        android:visibility="gone" />

    <TextView
        android:id="@+id/w_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:textColor="@color/ink_muted"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/w_last"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="@color/ink_muted"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/w_sync"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1.3"
            android:background="@drawable/widget_btn_primary"
            android:gravity="center"
            android:maxLines="1"
            android:text="Synchronizovať"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/w_toggle"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn"
            android:gravity="center"
            android:maxLines="1"
            android:text="Pozastaviť"
            android:textColor="@color/ink"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/w_open"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:layout_weight="0.8"
            android:background="@drawable/widget_btn"
            android:gravity="center"
            android:maxLines="1"
            android:text="Detaily"
            android:textColor="@color/ink"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
